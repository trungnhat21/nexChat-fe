# Port for local development server
VITE_PORT=3000

# Allowed hosts for Vite dev server
VITE_ALLOWED_HOST=localhost

# Backend API base URL
# Local dev: http://localhost:8080
# Production (Vercel): https://your-backend-app.onrender.com
VITE_API_BASE_URL=http://localhost:8080

# Optional: Dedicated Socket.IO URL (if different from VITE_API_BASE_URL)
# VITE_SOCKET_URL=https://your-backend-app.onrender.com
